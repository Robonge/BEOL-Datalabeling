# 사이트 환경 변수 예시(placeholder만, 공개 저장소). tools/site_init.py가 workspaces/_site/beol.env로 복사한다(chmod 600).
# workspaces/_site/는 git에 올라가지 않는다. 실제 호스트·키 값은 그 사본에만 적는다.
# 셸 rc와 crontab이 읽는다:  set -a; . <릴리스 폴더>/workspaces/_site/beol.env; set +a
# 값이 빈 줄은 그대로 두면 "설정 안 함"이다(빈 값은 labelbot이 무시한다).

# ---- 공통 ----
export TZ=Asia/Seoul
export PYTHONIOENCODING=utf-8
export BEOL_NO_BROWSER=1
export PATH="$HOME/.local/bin:$PATH"

# ---- 프록시(CLOUD_SETUP.md 3절). 사내 API·S3·벡터 DB·미러는 NO_PROXY에 넣는다 ----
# export HTTPS_PROXY=http://<proxy-host>:<proxy-port>
# export HTTP_PROXY="$HTTPS_PROXY" https_proxy="$HTTPS_PROXY" http_proxy="$HTTPS_PROXY"
# export NO_PROXY=localhost,127.0.0.1,<사내 도메인 접미사>
# export no_proxy="$NO_PROXY"

# ---- 화면 서버 역방향 프록시(C5 측정 뒤) ----
# BEOL_ALLOWED_HOSTS: 브라우저가 보는 프록시 호스트 이름(쉼표, 포트 무관)
export BEOL_ALLOWED_HOSTS=
# BEOL_PATH_PREFIX: 프록시가 떼지 않고 넘기는 경로 접두어(예: /absproxy/8771). 떼고 넘기면 비운다
export BEOL_PATH_PREFIX=

# ---- 외부 전송 가드(B2b 이후 필수). 사내 API·S3 도메인 접미사(쉼표) ----
export BEOL_ALLOWED_HOST_SUFFIXES=

# ---- 사내 OpenAI 호환 API 키(이름만, 값은 사본에만). pipeline.json llm·embedding의 api_key_env와 이름이 같아야 한다 ----
export BEOL_LLM_API_KEY=
export BEOL_EMBED_API_KEY=

# ---- 슬라이드 렌더 브라우저(CLOUD_SETUP.md 7절) ----
# 실행 파일 경로 또는 Chrome for Testing을 푼 폴더(그 아래 chrome-linux64/chrome). 비우면 PATH의 chromium 등을 찾는다
export BEOL_CHROME=
# root로 돌거나 사용자 네임스페이스가 막힌 컨테이너면 1(--no-sandbox). /dev/shm이 작으면 자동으로 --disable-dev-shm-usage
# export BEOL_CHROME_NO_SANDBOX=1
