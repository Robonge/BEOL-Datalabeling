# 비밀값 (템플릿 .env.example만 커밋한다)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# oh-my-claudecode 운영 상태 (프로젝트 스킬만 커밋)
.omc/*
!.omc/skills/

# 작업 폴더(사내 자료 b64·DB 포함, 커밋하지 않는다)
workspaces/
code_engrbot/out/

# Office 잠금 파일
~$*

# 세션 변경 대시보드 생성물(요청 원문 포함)
change-dashboard/data/
change-dashboard/reports/
change-dashboard/index.html

.superdesign/tmp/

# 하위 폴더에 생긴 oh-my-claudecode 상태(루트 .omc/skills만 커밋한다)
*/**/.omc/
