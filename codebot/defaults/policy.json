{
  "version": 1,
  "targets": ["labelbot", "engrbot", "codebot", "tests", ".claude/skills"],
  "exclude": ["**/__pycache__/**", "codebot/out/**"],
  "layers": ["C1", "C2", "C3", "C4"],
  "severity_overrides": {},
  "allow": [
    {"rule": "C2_SECRET_LITERAL", "path": "engrbot/tests/test_judge.py", "reason": "키가 로그에 새지 않는지 보는 테스트용 가짜 키다"},
    {"rule": "C1_OPEN_OUTSIDE_INGEST", "path": "labelbot/selfcheck.py", "reason": "자체 점검이 방금 쓴 왕복 확인 파일을 다시 읽는다"}
  ],
  "c1": {
    "ingest_modules": ["labelbot/ingest.py"],
    "forbidden_write_exts": [".pptx", ".xlsx", ".docx", ".csv", ".txt", ".pdf", ".hwp", ".ppt", ".doc", ".xls"],
    "local_packages": ["labelbot", "engrbot", "codebot", "tests"],
    "test_globs": ["tests/**", "engrbot/tests/**", "codebot/tests/**"]
  },
  "c2": {
    "transport_modules": ["labelbot/llm.py"]
  },
  "c3": {
    "cli_modules": {"labelbot": "labelbot/cli.py", "engrbot": "engrbot/cli.py", "codebot": "codebot/cli.py"},
    "doc_globs": [".claude/skills/*/SKILL.md", "README.md"],
    "contract": {"required": "engrbot/adapters/labelbot_ws.py", "tables": "labelbot/store.py"},
    "labelbot_import_allowed": ["engrbot/adapters/labelbot_ws.py", "engrbot/io.py", "engrbot/llm_http.py"]
  }
}
