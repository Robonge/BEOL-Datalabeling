# [사외 구동 기준] labelbot PoC 환경변수 템플릿
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올리지 않는다(.gitignore).
# 사내 반입본에서는 .env를 쓰지 않고, 사내 셸 환경변수로 넣는다.
# 이미 셸에 같은 이름의 환경변수가 있으면 그 값이 우선한다(.env가 덮어쓰지 않는다).

# --- OpenAI (1~3차 LLM, 임베딩) ---
# pipeline.json의 llm.api_key_env, embedding.api_key_env 기본값과 이름이 같다.
OPENAI_API_KEY=

# --- Supabase (push-vectors, 사외 PoC 전용) ---
# 프로젝트 URL: https://<project-ref>.supabase.co
# pipeline.json의 supabase.url이 비어 있으면 이 값을 쓴다.
SUPABASE_URL=
# service_role 키. REST로 표에 쓰는 데 쓴다. 절대 커밋하거나 화면·로그에 붙여넣지 않는다.
# pipeline.json의 supabase.key_env 기본값과 이름이 같다.
SUPABASE_SERVICE_KEY=
